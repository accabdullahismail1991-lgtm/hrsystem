# Copy to .env and fill in. Never commit the real .env file.

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=4000

# --- Database ---
# DB_CLIENT=sqlite (default) needs no other config — data is stored in
# a local file at SQLITE_FILE (created automatically).
DB_CLIENT=sqlite
SQLITE_FILE=./data/hrsystem.sqlite3

# DB_CLIENT=pg switches to PostgreSQL. Set either DATABASE_URL, or the
# individual PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE vars.
# DB_CLIENT=pg
# DATABASE_URL=postgres://user:password@host:5432/hrsystem
